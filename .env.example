# Copy to .env for local use, or set these in the hosting/CI environment. All optional.

# Absolute URL of the live site (used for sitemap.xml / robots.txt).
SITE_URL=https://www.melrosemnhistory.com

# Only when the site is served from a sub-path (previews). Leave unset for a normal domain root.
# SITE_BASE=/mockups/preview/

# Set to true on staging/preview builds to add <meta name="robots" content="noindex"> and disallow crawling.
# Leave unset/false for production.
# PUBLIC_NOINDEX=true

# Self-hosted Umami analytics (carried over from the old site). Both must be set to enable it.
PUBLIC_UMAMI_SRC=https://umami.dustinrue.com/umami
PUBLIC_UMAMI_ID=7bdeb488-e18a-4538-a73a-c84dc6eda37f
